<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/icons/favicon.svg">
</head>
<body>
    <main class="page-container">
        <div class="auth-container">
            <% if (locals.errors && locals.errors.length > 0) { %>
                <ul class="error-container">
                    <% errors.forEach((error) => { %>
                        <li><%= error.msg %></li>
                    <% }); %>
                </ul>
            <% } %>
            <h1 class="color-title">Sign Up</h1>
            <form method="POST" action="/sign-up" class="auth-form">
                <div class="form-input-container">
                    <label for="username">Username: </label>
                    <input type="text" name="username" id="username">
                </div>

                <div class="form-input-container">
                    <label for="email">Email: </label>
                    <input type="email" name="email" id="email">
                </div>

                <div class="form-input-container">
                    <label for="password">Password: </label>
                    <input type="text" name="password" id="password">
                </div>

                <div class="form-input-container">
                    <label for="confirm-password">Confirm Password: </label>
                    <input type="text" name="confirm-password" id="confirm-password">
                </div>

                <div class="sign-up-btn-container">
                    <button type="button" id="toggle-button" class="toggle-button">
                       Hide Password
                    </button>
                    <a href="/login">Cancel</a>
                    <button class="confirm-button" type="submit">Submit</button>
                </div>
            </form>
        </div>
    </main>
</body>
<script>
        let isShowing = true;
        const toggleBtn = document.getElementById("toggle-button");
        const passwordInput = document.getElementById("password");
        const confirmPasswordInput = document.getElementById("confirm-password");

        toggleBtn.addEventListener("click", () => {
            isShowing = !isShowing;
            passwordInput.type = isShowing ? "text" : "password";
            confirmPasswordInput.type = isShowing ? "text" : "password";
            toggleBtn.textContent = isShowing ? "Hide Password" : "Show Password";
        });
</script>
</html>