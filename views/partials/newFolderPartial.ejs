<dialog id="folder-dialog">
    <form method="POST" action="/newFolder">
        <div>
            <label for="folderName">Folder Name: </label>
            <input type="text" name="folderName" id="folderName" required>
        </div>

        <div>
            <button type="button" onclick="updateFolderDialog.close()">Close</button>
            <button type="submit">Create Folder</button>
        </div>
    </form>
</dialog>