<dialog id="update-folder-dialog" class="dialog">
    <form method="POST" action="/folder/<%= folder.id %>/edit">
        <div>
            <label for="folderName">New Name: </label>
            <input type="text" name="newName" id="newName" required>
        </div>

        <div class="dialog-buttons-container">
            <button type="button" onclick="updateFolderDialog.close()">Close</button>
            <button type="submit">Update Folder</button>
        </div>
    </form>
</dialog>