<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vaultly: File Uploader</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="icon" href="/icons/favicon.svg">
</head>
<body>
    <% if (locals.user) { %>
        <main class="page-container">
            <%-include("./partials/sidebarPartial.ejs") %>
            <section class="main-content">
                <%-include("./partials/uploadDialogPartial.ejs") %>
                <%-include("./partials/uploadButtonPartial.ejs") %>
                <%-include("./partials/newFolderPartial.ejs") %>
                <h2><%= folder.name %></h2>
                <div>
                    <ul class="files-container">
                        <% if (locals.files && files.length > 0) { %>
                            <% locals.files.forEach((file) => { %>
                                <li class="file-row">
                                        <p class="file-title"><%= file.fileName %></p>

                                        <p>Folder: <%= file.folder ? file.folder.name : "No folder" %></p>

                                        <p>Created on: <span class="date" data-date="<%= file.uploadedAt %>"></span></p>

                                        <p>Size: <%= file.fileSize %> bytes</p>

                                        <p>Kind: <%= file.fileType %></p>

                                        <div class="file-button-container">
                                            <a href="/file/<%= file.id %>/download" aria-label="download button">
                                                <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 -960 960 960" width="100%" fill="#000000"><path d="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z"/></svg>
                                            </a>

                                            <form method="POST" action="/file/<%= file.id %>/delete">
                                                <button type="submit" class="delete-file-button" aria-label="delete button">
                                                    <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 -960 960 960" width="100%" fill="#ca3737"><path d="m336-280 144-144 144 144 56-56-144-144 144-144-56-56-144 144-144-144-56 56 144 144-144 144 56 56ZM480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320Z"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                </li>
                            <% }) %>
                        <% } else { %>
                            <p>No files uploaded yet.</p>
                        <% } %>
                    </ul>
                </div>
            </section>
        </main>
    <% } else { %>
        <main class="page-container">
            <p>No user logged in.</p>
            <a href="/login">Click Here to log in</a>
        </main>
    <% } %>
    <script>
        const dialog = document.getElementById("upload-dialog");
        const folderDialog = document.getElementById("folder-dialog");

        document.querySelectorAll(".date").forEach((el) => {
            const date = new Date(el.dataset.date);
            el.textContent = date.toLocaleString("en-us", {
                year: "numeric", month: "short", day: "numeric",
                hour: "2-digit", minute: "2-digit"
            })
        });
    </script>
</body>
</html>